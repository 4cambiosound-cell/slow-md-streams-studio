# ============================================================================
# RADIO LIVE INTERACTIVA & SLOW MD STREAM BOT — VARIABLES DE ENTORNO (.env)
# ============================================================================
# Copia este archivo como `.env` y completa únicamente las credenciales que utilices.
# Ninguna credencial real debe subirse al repositorio.

# Puerto del servidor HTTP / WebSocket (por defecto 3000)
PORT=3000

# Clave opcional de YouTube Data API v3 para búsquedas oficiales de alta cuota.
# Si se deja vacío, el sistema utiliza automáticamente el adaptador de búsqueda directa + oEmbed.
YOUTUBE_API_KEY=

# Configuración opcional de OBS WebSocket v5 (para control de fuentes de audio externas en OBS Studio)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
